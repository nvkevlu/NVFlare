          "$ref": "#/$defs/timestamp"
        }
      }
    },
    "absent_participant_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "participant_name",
        "role",
        "status"
      ],
      "properties": {
        "participant_name": {
          "$ref": "#/$defs/participant_name"
        },
        "role": {
          "enum": [
            "client",
            "server"
          ]
        },
        "status": {
          "enum": [
            "missing",
            "disabled"
          ]
        }
      }
