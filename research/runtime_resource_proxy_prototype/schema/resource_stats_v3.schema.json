    "study_selection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "study_name"
      ],
      "properties": {
        "study_name": {
          "$ref": "#/$defs/study_name"
        }
      }
    },
    "study_coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "selected_jobs",
        "included_jobs",
        "unavailable_jobs",
        "nonterminal_jobs"
      ],
      "properties": {
        "selected_jobs": {
          "$ref": "#/$defs/unsigned"
        },
        "included_jobs": {
          "$ref": "#/$defs/unsigned"
        },
        "unavailable_jobs": {
          "$ref": "#/$defs/unsigned"
        },
        "nonterminal_jobs": {
          "$ref": "#/$defs/unsigned"
        }
      }
    },
    "included_job_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "job_id",
        "job_name",
        "job_status",
        "resource_data",
        "totals"
      ],
      "properties": {
        "job_id": {
          "$ref": "#/$defs/job_id"
        },
        "job_name": {
          "$ref": "#/$defs/job_name"
        },
        "job_status": {
          "allOf": [
            {
              "$ref": "#/$defs/job_status"
            }
          ],
          "pattern": "^(?:FINISHED:.*|FINISHED_OK|FINISHED_EXCEPTION|ABORTED|ABANDONED|FAILED)$",
          "description": "Included resource data requires a terminal NVFlare job status."
        },
        "resource_data": {
          "const": "included",
          "description": "This finalized job contributes to study totals."
        },
        "totals": {
          "$ref": "#/$defs/totals"
        }
      }
    },
    "excluded_job_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "job_id",
        "job_name",
        "job_status",
        "resource_data"
      ],
      "properties": {
        "job_id": {
          "$ref": "#/$defs/job_id"
        },
        "job_name": {
          "$ref": "#/$defs/job_name"
        },
        "job_status": {
          "$ref": "#/$defs/job_status"
        },
        "resource_data": {
          "enum": [
            "unavailable",
            "nonterminal"
          ],
          "description": "Why the selected job contributes no totals; distinct from job_status."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "resource_data": {
                "const": "unavailable"
              }
            }
          },
          "then": {
            "properties": {
              "job_status": {
                "pattern": "^(?:FINISHED:.*|FINISHED_OK|FINISHED_EXCEPTION|ABORTED|ABANDONED|FAILED)$"
              }
            }
          },
          "else": {
            "properties": {
              "job_status": {
                "not": {
                  "pattern": "^(?:FINISHED:.*|FINISHED_OK|FINISHED_EXCEPTION|ABORTED|ABANDONED|FAILED)$"
                }
              }
            }
          }
        }
      ]
    },
    "study_job_row": {
      "oneOf": [
        {
          "$ref": "#/$defs/included_job_row"
        },
        {
          "$ref": "#/$defs/excluded_job_row"
        }
      ]
    },
