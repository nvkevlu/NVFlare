{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nvflare.nvidia.com/schemas/resource_stats/v3/resource_stats.json",
  "title": "NVFlare final raw-capacity resource-statistics record v3",
  "description": "Closed schema 3 records store observed participant capacities; only transient job/study queries derive capacity-time. Numeric semantic bounds are enforced by the production validator.",
  "oneOf": [
    {
      "$ref": "#/$defs/participant_summary"
    },
    {
      "$ref": "#/$defs/resource_summary"
    },
    {
      "$ref": "#/$defs/study_summary"
    }
  ],
  "x-nvflare-units": {
    "measured_seconds": "seconds",
    "cpu_consumed.seconds": "user plus system CPU seconds consumed by observed job execution processes",
    "unit_seconds": "CPU-unit seconds",
    "instance_seconds": "CUDA-device seconds; each Driver-counted device contributes to exactly one type group",
    "byte_seconds": "byte-seconds",
    "capacity_bytes": "bytes",
    "bytes": "bytes",
    "sent_bytes": "encoded and encrypted CellNet payload bytes whose send returned without error",
    "received_bytes": "encoded and encrypted CellNet payload bytes observed at transport ingress",
    "units": "logical CPU capacity units",
    "count": "CUDA Driver execution-visible devices"
  },
  "x-nvflare-cross-record-invariants": [
    "live and archived records use only schema 3.0; earlier unreleased prototype formats are not accepted",
    "one terminal participant report and each accepted job-summary entry store resource_capacity, never resource_time or derived products",
    "the usual resource_capacity form stores measured_seconds plus raw cpu units, memory bytes, and CUDA device counts",
    "exceptional capacity changes store 2..4096 intervals instead of flat dimensions; outer measured_seconds equals the sum of positive covered interval durations",
    "complete capacity omits status/issues and includes all dimensions; partial retains measured_seconds and known dimensions with issues; unavailable contains only status/issues",
    "CPU capacity is positive with a combined maximum of 1048576 units; memory bytes are positive unsigned 64-bit integers; GPU groups contain positive integer counts with a combined maximum of 4096",
    "an empty GPU groups array is observed zero; missing Driver or count failure leaves GPU unavailable and does not erase known CPU/memory",
    "the CUDA Driver alone establishes count; optional NVML only classifies counted devices; raw masks/UUIDs/PCI IDs/host identifiers are forbidden",
    "query totals retain resource_time and multiply each capacity interval by its own duration with bounded decimal arithmetic; they do not sum filesystem capacity",
    "accepted participant entries copy normalized capacity, CPU consumption, retained bytes and directional payload counters exactly from accepted participant records",
    "traffic includes control payloads, retries and relay hops observed by the job cell before its snapshot, but not shared parent traffic, CellNet headers or transport framing",
    "sent_bytes and received_bytes are independently observed and summed independently; sends do not prove arrival, and receives do not prove application processing",
    "actual CPU consumption has its own measured duration; partial GPU capacity cannot invalidate a known CPU average",
    "input whitespace/order/equivalent decimal spellings do not affect validity; writers normalize numbers and deterministic collection order",
    "the server independently knows expected participants and classifies missing/invalid/disabled reports at cutoff",
    "missing or incomplete expected reports make relevant totals partial; unavailable means no usable measurement",
    "study totals combine included current-format jobs; coverage separately counts missing reports and nonterminal jobs",
    "job_name is query-only existing metadata; participant/job storage identity remains job_id",
    "the archive stores one participant file per accepted participant and writes resource_summary.json last"
  ],
  "x-nvflare-privacy": [
    "hardware models are optional and may be omitted",
    "CPU groups are separated when normalized model or architecture labels differ",
    "forbidden: raw cpuinfo, flags, topology, serials, UUIDs, PCI addresses, host identifiers, and raw CUDA mask values"
  ],
  "x-nvflare-deployment-constraints": [
    "collection uses the permissions, workspace, and message paths NVFlare already has",
    "collection requires no root access, privileged container, host service, sidecar, Docker socket, additional Kubernetes RBAC permission, cloud permission, or Slurm administrator access",
    "collection requires no new mount, launcher argument, environment variable, job setting, operator setting, or deployment setup"
  ],
  "$defs": {
    "schema_version": {
      "const": "3.0"
    },
    "job_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "job_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255,
      "description": "Query-only display name from persisted job metadata; Unicode and controls are retained in JSON and escaped for terminal display. Never a replacement for job_id."
    },
    "participant_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_-][A-Za-z0-9_.-]{0,127}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "maxLength": 40,
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,9})?Z$"
    },
    "unsigned": {
      "type": "string",
      "pattern": "^[0-9]{1,39}(?:\\.0{1,9})?$"
    },
    "positive_unsigned": {
      "type": "string",
      "pattern": "^(?!0+(?:\\.0+)?$)[0-9]{1,39}(?:\\.0{1,9})?$"
    },
    "decimal": {
      "type": "string",
      "pattern": "^[0-9]{1,39}(?:\\.[0-9]{1,9})?$"
    },
    "positive_decimal": {
      "type": "string",
      "pattern": "^(?!0+(?:\\.0+)?$)[0-9]{1,39}(?:\\.[0-9]{1,9})?$"
    },
    "model": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9 ._()+/@-]{0,127}$",
      "allOf": [
        {
          "not": {
            "pattern": "(?:GPU|MIG|MIG-GPU)-[0-9A-Fa-f-]{16,}"
          }
        },
        {
          "not": {
            "pattern": "(?:[0-9A-Fa-f]{4}:)?[0-9A-Fa-f]{2}:[0-9A-Fa-f]{2}\\.[0-7]"
          }
        },
        {
          "not": {
            "pattern": "[Ss][Ee][Rr][Ii][Aa][Ll]|[Uu][Uu][Ii][Dd]|[Cc][Uu][Dd][Aa]_[Vv][Ii][Ss][Ii][Bb][Ll][Ee]_[Dd][Ee][Vv][Ii][Cc][Ee][Ss]|[Pp][Cc][Ii]_[Bb][Uu][Ss]_[Ii][Dd]|[Hh][Oo][Ss][Tt][Nn][Aa][Mm][Ee]"
          }
        }
      ]
    },
    "architecture": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,31}$"
    },
    "mig_profile": {
      "type": "string",
      "maxLength": 32,
      "pattern": "^[1-9][0-9]*g\\.[1-9][0-9]*gb(?:\\+me)?$"
    },
    "study_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 63,
      "pattern": "^[a-z0-9](?:[a-z0-9_-]{0,61}[a-z0-9])?$"
    },
    "job_status": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9 ._:/+-]{0,63}$",
      "description": "Bounded underlying NVFlare job-lifecycle value; distinct from resource_data."
    },
    "capacity_unavailable_issue": {
      "enum": [
        "attribution_incomplete",
        "malformed_source",
        "observation_incomplete",
        "unsupported"
      ]
    },
    "source_unavailable_issue": {
      "enum": [
        "attribution_incomplete",
        "malformed_source",
        "observation_incomplete",
        "unsupported"
      ]
    },
    "partial_issue": {
      "enum": [
        "observation_incomplete"
      ]
    },
    "resource_time_partial_issue": {
      "enum": [
        "attribution_incomplete",
        "observation_incomplete"
      ]
    },
    "resource_time_unavailable_issue": {
      "enum": [
        "attribution_incomplete",
        "malformed_source",
        "observation_incomplete",
        "unsupported"
      ]
    },
    "capacity_unavailable": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "issues"
      ],
      "properties": {
        "status": {
          "const": "unavailable"
        },
        "issues": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/capacity_unavailable_issue"
          }
        }
      }
    },
    "source_unavailable": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "issues"
      ],
      "properties": {
        "status": {
          "const": "unavailable"
        },
        "issues": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/source_unavailable_issue"
          }
        }
      }
    },
    "workspace_filesystem_complete": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capacity_bytes"
      ],
      "properties": {
        "capacity_bytes": {
          "$ref": "#/$defs/positive_unsigned",
          "description": "Final visible capacity of the filesystem containing the existing NVFlare job workspace."
        }
      }
    },
    "workspace_filesystem": {
      "oneOf": [
        {
          "$ref": "#/$defs/workspace_filesystem_complete"
        },
        {
          "$ref": "#/$defs/capacity_unavailable"
        }
      ]
    },
    "cpu_time_group": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "unit_seconds"
      ],
      "properties": {
        "unit_seconds": {
          "$ref": "#/$defs/decimal"
        },
        "model": {
          "$ref": "#/$defs/model"
        },
        "architecture": {
          "$ref": "#/$defs/architecture"
        }
      }
    },
    "cpu_time": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "groups"
      ],
      "properties": {
        "groups": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4096,
          "items": {
            "$ref": "#/$defs/cpu_time_group"
          }
        }
      }
    },
    "memory_time": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "byte_seconds"
      ],
      "properties": {
        "byte_seconds": {
          "$ref": "#/$defs/decimal"
        }
      }
    },
    "full_gpu_time_group": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "instance_seconds"
      ],
      "properties": {
        "kind": {
          "const": "full_gpu"
        },
        "instance_seconds": {
          "$ref": "#/$defs/positive_decimal"
        },
        "model": {
          "$ref": "#/$defs/model"
        },
        "memory_bytes": {
          "$ref": "#/$defs/positive_unsigned"
        }
      }
    },
    "unclassified_gpu_time_group": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "instance_seconds"
      ],
      "properties": {
        "kind": {
          "const": "cuda_device_unclassified",
          "description": "CUDA Driver-counted device whose full-GPU or MIG type could not be verified."
        },
        "instance_seconds": {
          "$ref": "#/$defs/positive_decimal"
        },
        "model": {
          "$ref": "#/$defs/model"
        },
        "memory_bytes": {
          "$ref": "#/$defs/positive_unsigned"
        }
      }
    },
    "mig_gpu_time_group": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "instance_seconds"
      ],
      "properties": {
        "kind": {
          "const": "mig_compute_instance"
        },
        "instance_seconds": {
          "$ref": "#/$defs/positive_decimal"
        },
        "model": {
          "$ref": "#/$defs/model"
        },
        "memory_bytes": {
          "$ref": "#/$defs/positive_unsigned"
        },
        "mig_profile": {
          "$ref": "#/$defs/mig_profile"
        }
      }
    },
    "gpu_time": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "groups"
      ],
      "properties": {
        "groups": {
          "type": "array",
          "maxItems": 4096,
          "items": {
            "oneOf": [
              {
                "$ref": "#/$defs/full_gpu_time_group"
              },
              {
                "$ref": "#/$defs/mig_gpu_time_group"
              },
              {
                "$ref": "#/$defs/unclassified_gpu_time_group"
              }
            ]
          },
          "description": "Driver-counted devices: full_gpu and mig_compute_instance require NVML confirmation; type-unverified devices remain unclassified. An empty array is an authoritative observed zero."
        }
      }
    },
    "resource_time_complete": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "measured_seconds",
        "cpu",
        "memory",
        "gpu"
      ],
      "properties": {
        "measured_seconds": {
          "$ref": "#/$defs/decimal"
        },
        "cpu": {
          "$ref": "#/$defs/cpu_time"
        },
        "memory": {
          "$ref": "#/$defs/memory_time"
        },
        "gpu": {
          "$ref": "#/$defs/gpu_time"
        }
      }
    },
    "resource_time_partial": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "issues"
      ],
      "properties": {
        "status": {
          "const": "partial"
        },
        "issues": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/resource_time_partial_issue"
          }
        },
        "measured_seconds": {
          "$ref": "#/$defs/decimal"
        },
        "cpu": {
          "$ref": "#/$defs/cpu_time"
        },
        "memory": {
          "$ref": "#/$defs/memory_time"
        },
        "gpu": {
          "$ref": "#/$defs/gpu_time"
        }
      },
      "anyOf": [
        {
          "required": [
            "measured_seconds"
          ]
        },
        {
          "required": [
            "cpu"
          ]
        },
        {
          "required": [
            "memory"
          ]
        },
        {
          "required": [
            "gpu"
          ]
        }
      ]
    },
    "resource_time_unavailable": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "issues"
      ],
      "properties": {
        "status": {
          "const": "unavailable"
        },
        "issues": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/resource_time_unavailable_issue"
          }
        }
      }
    },
    "resource_time": {
      "oneOf": [
        {
          "$ref": "#/$defs/resource_time_complete"
        },
        {
          "$ref": "#/$defs/resource_time_partial"
        },
        {
          "$ref": "#/$defs/resource_time_unavailable"
        }
      ]
    },
    "cpu_consumed_complete": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "seconds"
      ],
      "properties": {
        "seconds": {
          "$ref": "#/$defs/decimal"
        },
        "measured_seconds": {
          "$ref": "#/$defs/decimal",
          "description": "Elapsed interval covered by this CPU counter, independent of resource-capacity sampling."
        }
      }
    },
    "cpu_consumed_partial": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "issues",
        "seconds"
      ],
      "properties": {
        "status": {
          "const": "partial"
        },
        "issues": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "enum": [
              "attribution_incomplete",
              "observation_incomplete"
            ]
          }
        },
        "seconds": {
          "$ref": "#/$defs/decimal"
        },
        "measured_seconds": {
          "$ref": "#/$defs/decimal"
        }
      }
    },
    "cpu_consumed": {
      "oneOf": [
        {
          "$ref": "#/$defs/cpu_consumed_complete"
        },
        {
          "$ref": "#/$defs/cpu_consumed_partial"
        },
        {
          "$ref": "#/$defs/source_unavailable"
        }
      ]
    },
    "cpu_consumed_total": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "seconds"
          ],
          "properties": {
            "seconds": {
              "$ref": "#/$defs/decimal"
            },
            "measured_seconds": {
              "$ref": "#/$defs/decimal"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "seconds"
          ],
          "properties": {
            "status": {
              "const": "partial"
            },
            "seconds": {
              "$ref": "#/$defs/decimal"
            },
            "measured_seconds": {
              "$ref": "#/$defs/decimal"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status"
          ],
          "properties": {
            "status": {
              "const": "unavailable"
            }
          }
        }
      ]
    },
    "retained_numeric": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bytes"
      ],
      "properties": {
        "bytes": {
          "$ref": "#/$defs/unsigned"
        }
      }
    },
    "retained_partial": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "issues",
        "bytes"
      ],
      "properties": {
        "status": {
          "const": "partial"
        },
        "issues": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "enum": [
              "attribution_incomplete",
              "observation_incomplete"
            ]
          }
        },
        "bytes": {
          "$ref": "#/$defs/unsigned"
        }
      }
    },
    "retained_content": {
      "oneOf": [
        {
          "$ref": "#/$defs/retained_numeric"
        },
        {
          "$ref": "#/$defs/retained_partial"
        },
        {
          "$ref": "#/$defs/source_unavailable"
        }
      ]
    },
    "message_traffic_complete": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sent_bytes",
        "received_bytes"
      ],
      "properties": {
        "sent_bytes": {
          "$ref": "#/$defs/unsigned"
        },
        "received_bytes": {
          "$ref": "#/$defs/unsigned"
        }
      }
    },
    "message_traffic_partial": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "issues",
        "sent_bytes",
        "received_bytes"
      ],
      "properties": {
        "status": {
          "const": "partial"
        },
        "issues": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/partial_issue"
          }
        },
        "sent_bytes": {
          "$ref": "#/$defs/unsigned"
        },
        "received_bytes": {
          "$ref": "#/$defs/unsigned"
        }
      }
    },
    "message_traffic": {
      "oneOf": [
        {
          "$ref": "#/$defs/message_traffic_complete"
        },
        {
          "$ref": "#/$defs/message_traffic_partial"
        },
        {
          "$ref": "#/$defs/message_traffic_unavailable"
        }
      ]
    },
    "message_traffic_unavailable": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "issues"
      ],
      "properties": {
        "status": {
          "const": "unavailable"
        },
        "issues": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "enum": [
              "malformed_source",
              "observation_incomplete"
            ]
          }
        }
      }
    },
    "retained_total": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "bytes"
          ],
          "properties": {
            "bytes": {
              "$ref": "#/$defs/unsigned"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "bytes"
          ],
          "properties": {
            "status": {
              "const": "partial"
            },
            "bytes": {
              "$ref": "#/$defs/unsigned"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status"
          ],
          "properties": {
            "status": {
              "const": "unavailable"
            }
          }
        }
      ]
    },
    "message_traffic_total": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sent_bytes",
            "received_bytes"
          ],
          "properties": {
            "sent_bytes": {
              "$ref": "#/$defs/unsigned"
            },
            "received_bytes": {
              "$ref": "#/$defs/unsigned"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "sent_bytes",
            "received_bytes"
          ],
          "properties": {
            "status": {
              "const": "partial"
            },
            "sent_bytes": {
              "$ref": "#/$defs/unsigned"
            },
            "received_bytes": {
              "$ref": "#/$defs/unsigned"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status"
          ],
          "properties": {
            "status": {
              "const": "unavailable"
            }
          }
        }
      ]
    },
    "totals": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resource_time",
        "cpu_consumed",
        "retained_content",
        "message_traffic"
      ],
      "properties": {
        "resource_time": {
          "$ref": "#/$defs/resource_time"
        },
        "cpu_consumed": {
          "$ref": "#/$defs/cpu_consumed_total"
        },
        "retained_content": {
          "$ref": "#/$defs/retained_total"
        },
        "message_traffic": {
          "$ref": "#/$defs/message_traffic_total"
        }
      }
    },
    "accepted_participant_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "participant_name",
        "role",
        "received_at",
        "resource_capacity",
        "cpu_consumed",
        "retained_content",
        "message_traffic"
      ],
      "properties": {
        "participant_name": {
          "$ref": "#/$defs/participant_name"
        },
        "role": {
          "enum": [
            "client",
            "server"
          ]
        },
