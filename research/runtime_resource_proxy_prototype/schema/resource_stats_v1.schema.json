{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nvflare.nvidia.com/schemas/resource_stats/v1/resource_stats.json",
  "title": "NVFlare final resource-statistics record v1",
  "description": "Closed records for one terminal participant report, a finalized job summary, and a transient study summary.",
  "oneOf": [
    {"$ref": "#/$defs/participant_summary"},
    {"$ref": "#/$defs/resource_summary"},
    {"$ref": "#/$defs/study_summary"}
  ],
  "x-nvflare-units": {
    "measured_seconds": "seconds",
    "unit_seconds": "CPU-unit seconds",
    "instance_seconds": "GPU- or MIG-instance seconds",
    "byte_seconds": "byte-seconds",
    "capacity_bytes": "bytes",
    "bytes": "bytes",
    "payload_bytes": "serialized application payload bytes",
    "messages": "messages"
  },
  "x-nvflare-cross-record-invariants": [
    "each participant emits one terminal participant_summary; v1 has no separate start, final, attempt, or environment records",
    "resource_time is the reporter's final measured total; the server validates and aggregates it but does not reconstruct it from timestamps or point-in-time capacity",
    "resource_time has one status covering CPU, memory, and GPU together",
    "a reported resource_time contains measured_seconds and all three numeric resources; a partial resource_time contains issues and at least one numeric member; an unavailable resource_time contains issues and no numeric members",
    "raw CUDA_VISIBLE_DEVICES text is never numeric authority; GPU instance-seconds require successful CUDA-runtime enumeration by the collector",
    "full GPUs and MIG compute instances remain separate groups; an empty groups array means observed zero",
    "workspace_filesystem is a point-in-time observation of the total visible capacity of exactly the filesystem containing the existing NVFlare job workspace; it is not usage, allocation, billable storage, or storage owned by the job",
    "accepted participant entries copy resource_time, retained_content, and f3 exactly from the accepted participant_summary",
    "the server obtains its expected participant list independently of report arrival and classifies every participant at the cutoff",
    "job totals are deterministic sums of accepted terminal reports; resource_time is partial whenever any expected participant report or resource_time is incomplete",
    "a study_summary is a transient view; job_status is the underlying NVFlare lifecycle value while resource_data says whether that job contributes totals",
    "study totals are deterministic sums of rows whose resource_data is included",
    "a finalized archive contains resource_summary.json and one participant record named by participant_name for every accepted participant; resource_summary.json is written last"
  ],
  "x-nvflare-privacy": [
    "hardware models are optional and may be omitted",
    "CPU groups are separated when normalized model or architecture labels differ",
    "forbidden: raw cpuinfo, flags, topology, serials, UUIDs, PCI addresses, host identifiers, and raw CUDA mask values"
  ],
  "x-nvflare-deployment-constraints": [
    "collection uses the permissions, workspace, and message paths NVFlare already has",
    "collection requires no root access, privileged container, host service, sidecar, Docker socket, additional Kubernetes RBAC permission, cloud permission, or Slurm administrator access",
    "collection requires no new mount, launcher argument, environment variable, job setting, operator setting, or deployment setup"
  ],
  "$defs": {
    "schema_version": {"const": "1.0"},
    "job_id": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "participant_name": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9_-][A-Za-z0-9_.-]{0,127}$"},
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "maxLength": 40,
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,9})?Z$"
    },
    "unsigned": {"type": "string", "pattern": "^(?:0|[1-9][0-9]{0,38})$"},
    "positive_unsigned": {"type": "string", "pattern": "^[1-9][0-9]{0,38}$"},
    "decimal": {"type": "string", "pattern": "^(?:0|[1-9][0-9]{0,38})(?:\\.[0-9]{0,8}[1-9])?$"},
    "positive_decimal": {"type": "string", "pattern": "^(?:0\\.[0-9]{0,8}[1-9]|[1-9][0-9]{0,38}(?:\\.[0-9]{0,8}[1-9])?)$"},
    "model": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9 ._()+/@-]{0,127}$",
      "allOf": [
        {"not": {"pattern": "(?:GPU|MIG|MIG-GPU)-[0-9A-Fa-f-]{16,}"}},
        {"not": {"pattern": "(?:[0-9A-Fa-f]{4}:)?[0-9A-Fa-f]{2}:[0-9A-Fa-f]{2}\\.[0-7]"}},
        {"not": {"pattern": "[Ss][Ee][Rr][Ii][Aa][Ll]|[Uu][Uu][Ii][Dd]|[Cc][Uu][Dd][Aa]_[Vv][Ii][Ss][Ii][Bb][Ll][Ee]_[Dd][Ee][Vv][Ii][Cc][Ee][Ss]|[Pp][Cc][Ii]_[Bb][Uu][Ss]_[Ii][Dd]|[Hh][Oo][Ss][Tt][Nn][Aa][Mm][Ee]"}}
      ]
    },
    "architecture": {"type": "string", "minLength": 1, "maxLength": 32, "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,31}$"},
    "mig_profile": {"type": "string", "maxLength": 32, "pattern": "^[1-9][0-9]*g\\.[1-9][0-9]*gb(?:\\+me)?$"},
    "study_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 63,
      "pattern": "^[a-z0-9](?:[a-z0-9_-]{0,61}[a-z0-9])?$"
    },
    "job_status": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9 ._:/+-]{0,63}$",
      "description": "Bounded underlying NVFlare job-lifecycle value; distinct from resource_data."
    },
    "capacity_unavailable_issue": {"enum": ["attribution_incomplete", "dependency_missing", "observation_incomplete", "unsupported"]},
    "source_unavailable_issue": {"enum": ["attribution_incomplete", "dependency_missing", "not_bound", "observation_incomplete", "unsupported"]},
    "source_error_issue": {"enum": ["malformed_source", "permission_denied"]},
    "partial_issue": {"enum": ["attribution_incomplete", "counter_gap", "observation_incomplete"]},
    "resource_time_partial_issue": {"enum": ["attribution_incomplete", "observation_incomplete"]},
    "resource_time_unavailable_issue": {
      "enum": ["attribution_incomplete", "dependency_missing", "malformed_source", "not_bound", "observation_incomplete", "permission_denied", "unsupported"]
    },
    "capacity_unavailable": {
      "type": "object", "additionalProperties": false, "required": ["status", "issues"],
      "properties": {
        "status": {"const": "unavailable"},
        "issues": {"type": "array", "minItems": 1, "maxItems": 4, "uniqueItems": true, "items": {"$ref": "#/$defs/capacity_unavailable_issue"}}
      }
    },
    "source_unavailable": {
      "type": "object", "additionalProperties": false, "required": ["status", "issues"],
      "properties": {
        "status": {"const": "unavailable"},
        "issues": {"type": "array", "minItems": 1, "maxItems": 4, "uniqueItems": true, "items": {"$ref": "#/$defs/source_unavailable_issue"}}
      }
    },
    "source_error": {
      "type": "object", "additionalProperties": false, "required": ["status", "issues"],
      "properties": {
        "status": {"const": "error"},
        "issues": {"type": "array", "minItems": 1, "maxItems": 4, "uniqueItems": true, "items": {"$ref": "#/$defs/source_error_issue"}}
      }
    },
    "workspace_filesystem_reported": {
      "type": "object", "additionalProperties": false, "required": ["status", "capacity_bytes"],
      "properties": {
        "status": {"const": "reported"},
        "capacity_bytes": {"$ref": "#/$defs/positive_unsigned", "description": "Final visible capacity of the filesystem containing the existing NVFlare job workspace."}
      }
    },
    "workspace_filesystem": {
      "oneOf": [
        {"$ref": "#/$defs/workspace_filesystem_reported"},
        {"$ref": "#/$defs/capacity_unavailable"},
        {"$ref": "#/$defs/source_error"}
      ]
    },
    "cpu_time_group": {
      "type": "object", "additionalProperties": false, "required": ["unit_seconds"],
      "properties": {
        "unit_seconds": {"$ref": "#/$defs/decimal"},
        "model": {"$ref": "#/$defs/model"},
        "architecture": {"$ref": "#/$defs/architecture"}
      }
    },
    "cpu_time": {
      "type": "object", "additionalProperties": false, "required": ["groups"],
      "properties": {"groups": {"type": "array", "minItems": 1, "maxItems": 4096, "items": {"$ref": "#/$defs/cpu_time_group"}}}
    },
    "memory_time": {
      "type": "object", "additionalProperties": false, "required": ["byte_seconds"],
      "properties": {"byte_seconds": {"$ref": "#/$defs/decimal"}}
    },
    "full_gpu_time_group": {
      "type": "object", "additionalProperties": false, "required": ["kind", "instance_seconds"],
      "properties": {
        "kind": {"const": "full_gpu"},
        "instance_seconds": {"$ref": "#/$defs/positive_decimal"},
        "model": {"$ref": "#/$defs/model"},
        "memory_bytes": {"$ref": "#/$defs/positive_unsigned"}
      }
    },
    "mig_gpu_time_group": {
      "type": "object", "additionalProperties": false, "required": ["kind", "instance_seconds"],
      "properties": {
        "kind": {"const": "mig_compute_instance"},
        "instance_seconds": {"$ref": "#/$defs/positive_decimal"},
        "model": {"$ref": "#/$defs/model"},
        "memory_bytes": {"$ref": "#/$defs/positive_unsigned"},
        "mig_profile": {"$ref": "#/$defs/mig_profile"}
      }
    },
    "gpu_time": {
      "type": "object", "additionalProperties": false, "required": ["groups"],
      "properties": {
        "groups": {
          "type": "array",
          "maxItems": 4096,
          "items": {"oneOf": [{"$ref": "#/$defs/full_gpu_time_group"}, {"$ref": "#/$defs/mig_gpu_time_group"}]},
          "description": "An empty array is the authoritative observed-zero-GPU value."
        }
      }
    },
    "resource_time_reported": {
      "type": "object", "additionalProperties": false, "required": ["status", "measured_seconds", "cpu", "memory", "gpu"],
      "properties": {
        "status": {"const": "reported"},
        "measured_seconds": {"$ref": "#/$defs/decimal"},
        "cpu": {"$ref": "#/$defs/cpu_time"},
        "memory": {"$ref": "#/$defs/memory_time"},
        "gpu": {"$ref": "#/$defs/gpu_time"}
      }
    },
    "resource_time_partial": {
      "type": "object", "additionalProperties": false, "required": ["status", "issues"],
      "properties": {
        "status": {"const": "partial"},
        "issues": {"type": "array", "minItems": 1, "maxItems": 4, "uniqueItems": true, "items": {"$ref": "#/$defs/resource_time_partial_issue"}},
        "measured_seconds": {"$ref": "#/$defs/decimal"},
        "cpu": {"$ref": "#/$defs/cpu_time"},
        "memory": {"$ref": "#/$defs/memory_time"},
        "gpu": {"$ref": "#/$defs/gpu_time"}
      },
      "anyOf": [
        {"required": ["measured_seconds"]},
        {"required": ["cpu"]},
        {"required": ["memory"]},
        {"required": ["gpu"]}
      ]
    },
    "resource_time_unavailable": {
      "type": "object", "additionalProperties": false, "required": ["status", "issues"],
      "properties": {
        "status": {"const": "unavailable"},
        "issues": {"type": "array", "minItems": 1, "maxItems": 4, "uniqueItems": true, "items": {"$ref": "#/$defs/resource_time_unavailable_issue"}}
      }
    },
    "resource_time": {
      "oneOf": [
        {"$ref": "#/$defs/resource_time_reported"},
        {"$ref": "#/$defs/resource_time_partial"},
        {"$ref": "#/$defs/resource_time_unavailable"}
      ]
    },
    "retained_numeric": {
      "type": "object", "additionalProperties": false, "required": ["status", "bytes"],
      "properties": {"status": {"const": "reported"}, "bytes": {"$ref": "#/$defs/unsigned"}}
    },
    "retained_partial": {
      "type": "object", "additionalProperties": false, "required": ["status", "issues", "bytes"],
      "properties": {
        "status": {"const": "partial"},
        "issues": {"type": "array", "minItems": 1, "maxItems": 4, "uniqueItems": true, "items": {"enum": ["attribution_incomplete", "observation_incomplete"]}},
        "bytes": {"$ref": "#/$defs/unsigned"}
      }
    },
    "retained_content": {
      "oneOf": [
        {"$ref": "#/$defs/retained_numeric"},
        {"$ref": "#/$defs/retained_partial"},
        {"$ref": "#/$defs/source_unavailable"},
        {"$ref": "#/$defs/source_error"}
      ]
    },
    "counter": {
      "type": "object", "additionalProperties": false, "required": ["payload_bytes", "messages"],
      "properties": {"payload_bytes": {"$ref": "#/$defs/unsigned"}, "messages": {"$ref": "#/$defs/unsigned"}}
    },
    "f3_reported": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "remote_accepted", "local_delivered", "remote_failed_before_acceptance"],
      "properties": {
        "status": {"const": "reported"},
        "remote_accepted": {"$ref": "#/$defs/counter"},
        "local_delivered": {"$ref": "#/$defs/counter"},
        "remote_failed_before_acceptance": {"$ref": "#/$defs/counter"}
      }
    },
    "f3_partial": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "issues", "remote_accepted", "local_delivered", "remote_failed_before_acceptance"],
      "properties": {
        "status": {"const": "partial"},
        "issues": {"type": "array", "minItems": 1, "maxItems": 4, "uniqueItems": true, "items": {"$ref": "#/$defs/partial_issue"}},
        "remote_accepted": {"$ref": "#/$defs/counter"},
        "local_delivered": {"$ref": "#/$defs/counter"},
        "remote_failed_before_acceptance": {"$ref": "#/$defs/counter"}
      }
    },
    "f3": {
      "oneOf": [
        {"$ref": "#/$defs/f3_reported"},
        {"$ref": "#/$defs/f3_partial"},
        {"$ref": "#/$defs/source_unavailable"},
        {"$ref": "#/$defs/source_error"}
      ]
    },
    "retained_total": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false, "required": ["status", "bytes"],
          "properties": {"status": {"enum": ["reported", "partial"]}, "bytes": {"$ref": "#/$defs/unsigned"}}
        },
        {"type": "object", "additionalProperties": false, "required": ["status"], "properties": {"status": {"const": "unavailable"}}}
      ]
    },
    "f3_total": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false, "required": ["status", "remote_accepted"],
          "properties": {"status": {"enum": ["reported", "partial"]}, "remote_accepted": {"$ref": "#/$defs/counter"}}
        },
        {"type": "object", "additionalProperties": false, "required": ["status"], "properties": {"status": {"const": "unavailable"}}}
      ]
    },
    "totals": {
      "type": "object", "additionalProperties": false, "required": ["resource_time", "retained_content", "f3"],
      "properties": {
        "resource_time": {"$ref": "#/$defs/resource_time"},
        "retained_content": {"$ref": "#/$defs/retained_total"},
        "f3": {"$ref": "#/$defs/f3_total"}
      }
    },
    "accepted_participant_entry": {
      "type": "object", "additionalProperties": false,
      "required": ["participant_name", "role", "status", "received_at", "resource_time", "retained_content", "f3"],
      "properties": {
        "participant_name": {"$ref": "#/$defs/participant_name"},
        "role": {"enum": ["client", "server"]},
        "status": {"const": "accepted"},
        "received_at": {"$ref": "#/$defs/timestamp"},
        "resource_time": {"$ref": "#/$defs/resource_time"},
        "retained_content": {"$ref": "#/$defs/retained_content"},
        "f3": {"$ref": "#/$defs/f3"}
      }
    },
    "invalid_participant_entry": {
      "type": "object", "additionalProperties": false,
      "required": ["participant_name", "role", "status", "received_at", "issues"],
      "properties": {
        "participant_name": {"$ref": "#/$defs/participant_name"},
        "role": {"enum": ["client", "server"]},
        "status": {"const": "invalid"},
        "received_at": {"$ref": "#/$defs/timestamp"},
        "issues": {"type": "array", "minItems": 1, "maxItems": 1, "uniqueItems": true, "items": {"const": "malformed_source"}}
      }
    },
    "absent_participant_entry": {
      "type": "object", "additionalProperties": false, "required": ["participant_name", "role", "status"],
      "properties": {
        "participant_name": {"$ref": "#/$defs/participant_name"},
        "role": {"enum": ["client", "server"]},
        "status": {"enum": ["missing", "disabled"]}
      }
    },
    "participant_entry": {
      "oneOf": [
        {"$ref": "#/$defs/accepted_participant_entry"},
        {"$ref": "#/$defs/invalid_participant_entry"},
        {"$ref": "#/$defs/absent_participant_entry"}
      ]
    },
    "study_selection": {
      "type": "object", "additionalProperties": false, "required": ["study_name"],
      "properties": {"study_name": {"$ref": "#/$defs/study_name"}}
    },
    "study_coverage": {
      "type": "object", "additionalProperties": false,
      "required": ["selected_jobs", "included_jobs", "unavailable_jobs", "nonterminal_jobs"],
      "properties": {
        "selected_jobs": {"$ref": "#/$defs/unsigned"},
        "included_jobs": {"$ref": "#/$defs/unsigned"},
        "unavailable_jobs": {"$ref": "#/$defs/unsigned"},
        "nonterminal_jobs": {"$ref": "#/$defs/unsigned"}
      }
    },
    "included_job_row": {
      "type": "object", "additionalProperties": false,
      "required": ["job_id", "job_status", "resource_data", "totals"],
      "properties": {
        "job_id": {"$ref": "#/$defs/job_id"},
        "job_status": {
          "allOf": [{"$ref": "#/$defs/job_status"}],
          "pattern": "^(?:FINISHED:.*|FINISHED_OK|FINISHED_EXCEPTION|ABORTED|ABANDONED|FAILED)$",
          "description": "Included resource data requires a terminal NVFlare job status."
        },
        "resource_data": {"const": "included", "description": "This finalized job contributes to study totals."},
        "totals": {"$ref": "#/$defs/totals"}
      }
    },
    "excluded_job_row": {
      "type": "object", "additionalProperties": false, "required": ["job_id", "job_status", "resource_data"],
      "properties": {
        "job_id": {"$ref": "#/$defs/job_id"},
        "job_status": {"$ref": "#/$defs/job_status"},
        "resource_data": {
          "enum": ["unavailable", "nonterminal"],
          "description": "Why the selected job contributes no totals; distinct from job_status."
        }
      },
      "allOf": [
        {
          "if": {"properties": {"resource_data": {"const": "unavailable"}}},
          "then": {
            "properties": {
              "job_status": {
                "pattern": "^(?:FINISHED:.*|FINISHED_OK|FINISHED_EXCEPTION|ABORTED|ABANDONED|FAILED)$"
              }
            }
          },
          "else": {
            "properties": {
              "job_status": {
                "not": {
                  "pattern": "^(?:FINISHED:.*|FINISHED_OK|FINISHED_EXCEPTION|ABORTED|ABANDONED|FAILED)$"
                }
              }
            }
          }
        }
      ]
    },
    "study_job_row": {"oneOf": [{"$ref": "#/$defs/included_job_row"}, {"$ref": "#/$defs/excluded_job_row"}]},
    "participant_summary": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "kind", "job_id", "participant_name", "reported_at", "resource_time", "workspace_filesystem", "retained_content", "f3"],
      "properties": {
        "schema_version": {"$ref": "#/$defs/schema_version"},
        "kind": {"const": "nvflare.resource_stats.participant_summary"},
        "job_id": {"$ref": "#/$defs/job_id"},
        "participant_name": {"$ref": "#/$defs/participant_name"},
        "reported_at": {"$ref": "#/$defs/timestamp"},
        "resource_time": {"$ref": "#/$defs/resource_time"},
        "workspace_filesystem": {"$ref": "#/$defs/workspace_filesystem"},
        "retained_content": {"$ref": "#/$defs/retained_content"},
        "f3": {"$ref": "#/$defs/f3"}
      }
    },
    "resource_summary": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "kind", "job_id", "report_cutoff_at", "finalized_at", "participants", "totals"],
      "properties": {
        "schema_version": {"$ref": "#/$defs/schema_version"},
        "kind": {"const": "nvflare.resource_stats.resource_summary"},
        "job_id": {"$ref": "#/$defs/job_id"},
        "report_cutoff_at": {"$ref": "#/$defs/timestamp"},
        "finalized_at": {"$ref": "#/$defs/timestamp"},
        "participants": {"type": "array", "minItems": 1, "maxItems": 10000, "items": {"$ref": "#/$defs/participant_entry"}},
        "totals": {"$ref": "#/$defs/totals"}
      }
    },
    "study_summary": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "kind", "selection", "generated_at", "coverage", "jobs", "totals"],
      "properties": {
        "schema_version": {"$ref": "#/$defs/schema_version"},
        "kind": {"const": "nvflare.resource_stats.study_summary"},
        "selection": {"$ref": "#/$defs/study_selection"},
        "generated_at": {"$ref": "#/$defs/timestamp"},
        "coverage": {"$ref": "#/$defs/study_coverage"},
        "jobs": {"type": "array", "maxItems": 10000, "items": {"$ref": "#/$defs/study_job_row"}},
        "totals": {"$ref": "#/$defs/totals"}
      }
    }
  }
}
