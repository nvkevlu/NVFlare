{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nvflare.nvidia.com/schemas/resource_stats/v1/resource_stats.json",
  "title": "NVFlare participant resource-statistics record v1",
  "description": "Schema 1.0 scalar resource measurements use native numbers and per-metric status, with one scope-owned issues list tagged by metric and code.",
  "oneOf": [
    {
      "$ref": "#/$defs/participant_summary"
    },
    {
      "$ref": "#/$defs/resource_summary"
    },
    {
      "$ref": "#/$defs/study_summary"
    }
  ],
  "x-nvflare-units": {
    "unit_seconds": "CPU-unit seconds",
    "instance_seconds": "GPU-seconds: integer selected GPU count multiplied by execution seconds",
    "byte_seconds": "byte-seconds",
    "capacity_bytes": "bytes",
    "bytes": "bytes",
    "sent_bytes": "encoded and encrypted CellNet payload bytes whose send returned without error",
    "received_bytes": "encoded and encrypted CellNet payload bytes observed at transport ingress",
    "units": "logical CPU capacity units",
    "count": "integer NVIDIA inventory IDs selected by the execution's visibility mask",
    "duration_seconds": "elapsed seconds in the shared participant measurement window",
    "resource_utilization.cpu_consumed.cpu_seconds": "user plus system CPU seconds consumed by observed job execution processes"
  },
  "x-nvflare-cross-record-invariants": [
    "All live and archived records require schema 1.0.",
    "Quantities are finite nonnegative native JSON numbers; bytes/counts are integers and booleans or numeric strings are rejected.",
    "Startup capacity is scalar cpu.units, memory.bytes and gpu.count; capacity-time is scalar cpu.unit_seconds, memory.byte_seconds and gpu.instance_seconds.",
    "An explicit empty GPU pool is count:0; unavailable or invalid inventory does not erase independent CPU/RAM values.",
    "GPU counting uses NVFlare's shared integer-index visibility parser and verified nvidia-smi inventory in each execution's established environment; its command timeout is two seconds.",
    "GPU capacity and capacity-time describe verified inventory selections, not GPU utilization or exclusive hardware ownership.",
    "Accepted participant entries copy measurements from the matching authenticated participant record.",
    "Sent and received payload bytes are independently observed and summed; a send is not proof of arrival.",
    "Missing/incomplete expected reports make relevant totals partial; unavailable means no usable value.",
    "Study totals include readable finalized jobs; coverage counts excluded and nonterminal jobs separately.",
    "Archive publication writes accepted participant files before resource_summary.json.",
    "duration_seconds is one containing participant window, never the sum of worker durations.",
    "Queries sum recorded per-execution resource_time without multiplying startup capacity again.",
    "Each physical worker execution contributes once; no task/worker inventory or hardware grouping is public.",
    "Metrics retain their own exceptional status but never contain nested issues arrays.",
    "Participant reports, accepted participant rows, worker records and terminal handoffs own one issues list of unique {metric,code} entries sorted by metric then code; complete scopes use [].",
    "Derived job totals, per-study-job totals and study totals own aggregate issue lists rather than copying participant source details.",
    "The persisted job summary and study response do not add duplicate root issues lists around participant rows or totals.",
    "Each noncomplete metric has meaningful scope issues; a complete metric has none. Scope/metric/code correlations are enforced by the production contract."
  ],
  "x-nvflare-privacy": [
    "No hardware descriptions, raw CPU topology, UUIDs, serials, PCI addresses, host identifiers or raw visibility masks are reported."
  ],
  "x-nvflare-deployment-constraints": [
    "collection uses the permissions, workspace, and message paths NVFlare already has",
    "collection requires no root access, privileged container, host service, monitoring sidecar container, Docker socket, additional Kubernetes RBAC permission, cloud permission, or Slurm administrator access",
    "collection requires no new mount, launcher argument, environment variable, job setting, operator setting, or deployment setup"
  ],
  "$defs": {
    "schema_version": {
      "const": "1.0"
    },
    "job_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "job_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255,
      "description": "Query-only display name from persisted job metadata; Unicode and controls are retained in JSON and escaped for terminal display. Never a replacement for job_id."
    },
    "participant_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_-][A-Za-z0-9_.-]{0,127}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "maxLength": 40,
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,9})?Z$"
    },
    "unsigned": {
      "type": "integer",
      "minimum": 0
    },
    "positive_unsigned": {
      "type": "integer",
      "exclusiveMinimum": 0
    },
    "decimal": {
      "type": "number",
      "minimum": 0,
      "description": "Finite nonnegative JSON number."
    },
    "positive_decimal": {
      "type": "number",
      "exclusiveMinimum": 0,
      "description": "Finite positive JSON number."
    },
    "study_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 63,
      "pattern": "^[a-z0-9](?:[a-z0-9_-]{0,61}[a-z0-9])?$"
    },
    "job_status": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9 ._:/+-]{0,63}$",
      "description": "Bounded underlying NVFlare job-lifecycle value; distinct from resource_data."
    },
    "capacity_unavailable": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "const": "unavailable"
        }
      }
    },
    "source_unavailable": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "const": "unavailable"
        }
      }
    },
    "workspace_filesystem_complete": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capacity_bytes"
      ],
      "properties": {
        "capacity_bytes": {
          "$ref": "#/$defs/positive_unsigned",
          "description": "Final visible capacity of the filesystem containing the existing NVFlare job workspace."
        }
      }
    },
    "workspace_filesystem": {
      "oneOf": [
        {
          "$ref": "#/$defs/workspace_filesystem_complete"
        },
        {
          "$ref": "#/$defs/capacity_unavailable"
        }
      ]
    },
    "cpu_time": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "unit_seconds"
      ],
      "properties": {
        "unit_seconds": {
          "$ref": "#/$defs/decimal"
        }
      }
    },
    "memory_time": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "byte_seconds"
      ],
      "properties": {
        "byte_seconds": {
          "$ref": "#/$defs/decimal"
        }
      }
    },
    "gpu_time": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "instance_seconds"
      ],
      "properties": {
        "instance_seconds": {
          "$ref": "#/$defs/decimal"
        }
      }
    },
    "resource_time_complete": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cpu",
        "memory",
        "gpu"
      ],
      "properties": {
        "cpu": {
          "$ref": "#/$defs/cpu_time"
        },
        "memory": {
          "$ref": "#/$defs/memory_time"
        },
        "gpu": {
          "$ref": "#/$defs/gpu_time"
        }
      }
    },
    "resource_time_partial": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "const": "partial"
        },
        "cpu": {
          "$ref": "#/$defs/cpu_time"
        },
        "memory": {
          "$ref": "#/$defs/memory_time"
        },
        "gpu": {
          "$ref": "#/$defs/gpu_time"
        }
      },
      "anyOf": [
        {
          "required": [
            "cpu"
          ]
        },
        {
          "required": [
            "memory"
          ]
        },
        {
          "required": [
            "gpu"
          ]
        }
      ]
    },
    "resource_time_unavailable": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "const": "unavailable"
        }
      }
    },
    "resource_time": {
      "oneOf": [
        {
          "$ref": "#/$defs/resource_time_complete"
        },
        {
          "$ref": "#/$defs/resource_time_partial"
        },
        {
          "$ref": "#/$defs/resource_time_unavailable"
        }
      ]
    },
    "cpu_consumed_complete": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cpu_seconds"
      ],
      "properties": {
        "cpu_seconds": {
          "$ref": "#/$defs/decimal"
        }
      }
    },
    "cpu_consumed_partial": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "cpu_seconds"
      ],
      "properties": {
        "status": {
          "const": "partial"
        },
        "cpu_seconds": {
          "$ref": "#/$defs/decimal"
        }
      }
    },
    "cpu_consumed": {
      "oneOf": [
        {
          "$ref": "#/$defs/cpu_consumed_complete"
        },
        {
          "$ref": "#/$defs/cpu_consumed_partial"
        },
        {
          "$ref": "#/$defs/source_unavailable"
        }
      ]
    },
    "cpu_consumed_total": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "cpu_seconds"
          ],
          "properties": {
            "cpu_seconds": {
              "$ref": "#/$defs/decimal"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "cpu_seconds"
          ],
          "properties": {
            "status": {
              "const": "partial"
            },
            "cpu_seconds": {
              "$ref": "#/$defs/decimal"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status"
          ],
          "properties": {
            "status": {
              "const": "unavailable"
            }
          }
        }
      ]
    },
    "retained_numeric": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bytes"
      ],
      "properties": {
        "bytes": {
          "$ref": "#/$defs/unsigned"
        }
      }
    },
    "retained_partial": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "bytes"
      ],
      "properties": {
        "status": {
          "const": "partial"
        },
        "bytes": {
          "$ref": "#/$defs/unsigned"
        }
      }
    },
    "retained_content": {
      "oneOf": [
        {
          "$ref": "#/$defs/retained_numeric"
        },
        {
          "$ref": "#/$defs/retained_partial"
        },
        {
          "$ref": "#/$defs/source_unavailable"
        }
      ]
    },
    "message_traffic_complete": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sent_bytes",
        "received_bytes"
      ],
      "properties": {
        "sent_bytes": {
          "$ref": "#/$defs/unsigned"
        },
        "received_bytes": {
          "$ref": "#/$defs/unsigned"
        }
      }
    },
    "message_traffic_partial": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "sent_bytes",
        "received_bytes"
      ],
      "properties": {
        "status": {
          "const": "partial"
        },
        "sent_bytes": {
          "$ref": "#/$defs/unsigned"
        },
        "received_bytes": {
          "$ref": "#/$defs/unsigned"
        }
      }
    },
    "message_traffic": {
      "oneOf": [
        {
          "$ref": "#/$defs/message_traffic_complete"
        },
        {
          "$ref": "#/$defs/message_traffic_partial"
        },
        {
          "$ref": "#/$defs/message_traffic_unavailable"
        }
      ]
    },
    "message_traffic_unavailable": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "const": "unavailable"
        }
      }
    },
    "retained_total": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "bytes"
          ],
          "properties": {
            "bytes": {
              "$ref": "#/$defs/unsigned"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "bytes"
          ],
          "properties": {
            "status": {
              "const": "partial"
            },
            "bytes": {
              "$ref": "#/$defs/unsigned"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status"
          ],
          "properties": {
            "status": {
              "const": "unavailable"
            }
          }
        }
      ]
    },
    "message_traffic_total": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sent_bytes",
            "received_bytes"
          ],
          "properties": {
            "sent_bytes": {
              "$ref": "#/$defs/unsigned"
            },
            "received_bytes": {
              "$ref": "#/$defs/unsigned"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "sent_bytes",
            "received_bytes"
          ],
          "properties": {
            "status": {
              "const": "partial"
            },
            "sent_bytes": {
              "$ref": "#/$defs/unsigned"
            },
            "received_bytes": {
              "$ref": "#/$defs/unsigned"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status"
          ],
          "properties": {
            "status": {
              "const": "unavailable"
            }
          }
        }
      ]
    },
    "totals": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resource_time",
        "resource_utilization",
        "issues"
      ],
      "properties": {
        "resource_time": {
          "$ref": "#/$defs/resource_time"
        },
        "resource_utilization": {
          "$ref": "#/$defs/resource_utilization_total"
        },
        "issues": {
          "$ref": "#/$defs/total_issues"
        }
      }
    },
    "accepted_participant_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "participant_name",
        "role",
        "received_at",
        "resource_capacity",
        "resource_utilization",
        "resource_time",
        "issues"
      ],
      "properties": {
        "participant_name": {
          "$ref": "#/$defs/participant_name"
        },
        "role": {
          "enum": [
            "client",
            "server"
          ]
        },
        "received_at": {
          "$ref": "#/$defs/timestamp"
        },
        "resource_capacity": {
          "$ref": "#/$defs/resource_capacity"
        },
        "duration_seconds": {
          "$ref": "#/$defs/decimal",
          "description": "Shared elapsed measurement duration for this participant, including waiting. Omitted if timing is unavailable."
        },
        "resource_utilization": {
          "$ref": "#/$defs/resource_utilization"
        },
        "resource_time": {
          "$ref": "#/$defs/resource_time"
        },
        "issues": {
          "$ref": "#/$defs/participant_row_issues"
        }
      }
    },
    "invalid_participant_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "participant_name",
        "role",
        "status",
        "received_at"
      ],
      "properties": {
        "participant_name": {
          "$ref": "#/$defs/participant_name"
        },
        "role": {
          "enum": [
            "client",
            "server"
          ]
        },
        "status": {
          "const": "invalid"
        },
        "received_at": {
          "$ref": "#/$defs/timestamp"
        }
      }
    },
    "absent_participant_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "participant_name",
        "role",
        "status"
      ],
      "properties": {
        "participant_name": {
          "$ref": "#/$defs/participant_name"
        },
        "role": {
          "enum": [
            "client",
            "server"
          ]
        },
        "status": {
          "enum": [
            "missing",
            "disabled"
          ]
        }
      }
    },
    "participant_entry": {
      "oneOf": [
        {
          "$ref": "#/$defs/accepted_participant_entry"
        },
        {
          "$ref": "#/$defs/invalid_participant_entry"
        },
        {
          "$ref": "#/$defs/absent_participant_entry"
        }
      ]
    },
    "study_selection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "study_name"
      ],
      "properties": {
        "study_name": {
          "$ref": "#/$defs/study_name"
        }
      }
    },
    "study_coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "selected_jobs",
        "included_jobs",
        "unavailable_jobs",
        "nonterminal_jobs"
      ],
      "properties": {
        "selected_jobs": {
          "$ref": "#/$defs/unsigned"
        },
        "included_jobs": {
          "$ref": "#/$defs/unsigned"
        },
        "unavailable_jobs": {
          "$ref": "#/$defs/unsigned"
        },
        "nonterminal_jobs": {
          "$ref": "#/$defs/unsigned"
        }
      }
    },
    "included_job_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "job_id",
        "job_name",
        "job_status",
        "resource_data",
        "totals"
      ],
      "properties": {
        "job_id": {
          "$ref": "#/$defs/job_id"
        },
        "job_name": {
          "$ref": "#/$defs/job_name"
        },
        "job_status": {
          "allOf": [
            {
              "$ref": "#/$defs/job_status"
            }
          ],
          "pattern": "^(?:FINISHED:.*|FINISHED_OK|FINISHED_EXCEPTION|ABORTED|ABANDONED|FAILED)$",
          "description": "Included resource data requires a terminal NVFlare job status."
        },
        "resource_data": {
          "const": "included",
          "description": "This finalized job contributes to study totals."
        },
        "totals": {
          "$ref": "#/$defs/totals"
        }
      }
    },
    "excluded_job_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "job_id",
        "job_name",
        "job_status",
        "resource_data"
      ],
      "properties": {
        "job_id": {
          "$ref": "#/$defs/job_id"
        },
        "job_name": {
          "$ref": "#/$defs/job_name"
        },
        "job_status": {
          "$ref": "#/$defs/job_status"
        },
        "resource_data": {
          "enum": [
            "unavailable",
            "nonterminal"
          ],
          "description": "Why the selected job contributes no totals; distinct from job_status."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "resource_data": {
                "const": "unavailable"
              }
            }
          },
          "then": {
            "properties": {
              "job_status": {
                "pattern": "^(?:FINISHED:.*|FINISHED_OK|FINISHED_EXCEPTION|ABORTED|ABANDONED|FAILED)$"
              }
            }
          },
          "else": {
            "properties": {
              "job_status": {
                "not": {
                  "pattern": "^(?:FINISHED:.*|FINISHED_OK|FINISHED_EXCEPTION|ABORTED|ABANDONED|FAILED)$"
                }
              }
            }
          }
        }
      ]
    },
    "study_job_row": {
      "oneOf": [
        {
          "$ref": "#/$defs/included_job_row"
        },
        {
          "$ref": "#/$defs/excluded_job_row"
        }
      ]
    },
    "participant_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "kind",
        "job_id",
        "participant_name",
        "reported_at",
        "resource_capacity",
        "workspace_filesystem",
        "resource_utilization",
        "resource_time",
        "issues"
      ],
      "properties": {
        "schema_version": {
          "$ref": "#/$defs/schema_version"
        },
        "kind": {
          "const": "nvflare.resource_stats.participant_summary"
        },
        "job_id": {
          "$ref": "#/$defs/job_id"
        },
        "participant_name": {
          "$ref": "#/$defs/participant_name"
        },
        "reported_at": {
          "$ref": "#/$defs/timestamp"
        },
        "workspace_filesystem": {
          "$ref": "#/$defs/workspace_filesystem"
        },
        "resource_capacity": {
          "$ref": "#/$defs/resource_capacity"
        },
        "duration_seconds": {
          "$ref": "#/$defs/decimal",
          "description": "Shared elapsed measurement duration for this participant, including waiting. Omitted if timing is unavailable."
        },
        "resource_utilization": {
          "$ref": "#/$defs/resource_utilization"
        },
        "resource_time": {
          "$ref": "#/$defs/resource_time"
        },
        "issues": {
          "$ref": "#/$defs/scope_issues"
        }
      }
    },
    "resource_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "kind",
        "job_id",
        "participants"
      ],
      "properties": {
        "schema_version": {
          "$ref": "#/$defs/schema_version"
        },
        "kind": {
          "const": "nvflare.resource_stats.resource_summary"
        },
        "job_id": {
          "$ref": "#/$defs/job_id"
        },
        "participants": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10000,
          "items": {
            "$ref": "#/$defs/participant_entry"
          }
        }
      }
    },
    "study_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "kind",
        "selection",
        "generated_at",
        "coverage",
        "jobs",
        "totals"
      ],
      "properties": {
        "schema_version": {
          "$ref": "#/$defs/schema_version"
        },
        "kind": {
          "const": "nvflare.resource_stats.study_summary"
        },
        "selection": {
          "$ref": "#/$defs/study_selection"
        },
        "generated_at": {
          "$ref": "#/$defs/timestamp"
        },
        "coverage": {
          "$ref": "#/$defs/study_coverage"
        },
        "jobs": {
          "type": "array",
          "maxItems": 10000,
          "items": {
            "$ref": "#/$defs/study_job_row"
